mread(path)\n        if img_raw is None:\n            continue\n\n        raw_images.append(img_raw)\n        valid_filenames.append(fname)\n\n        img_rgb = cv2.cvtColor(img_raw, cv2.COLOR_BGR2RGB)\n        img_resized = cv2.resize(img_rgb, IMG_SIZE, interpolation=cv2.INTER_AREA)\n        input_tensors.append(img_resized / 255.0)\n\n    if not input_tensors:\n        return []\n\n    batch_array = np.array(input_tensors, dtype=np.float32)\n    pred_masks = unet_model.predict(batch_array, batch_size=len(batch_array), verbose=0)\n\n    results = []\n\n    for i in range(len(raw_images)):\n        img_raw = raw_images[i]\n        fname = valid_filenames[i]\n        orig_h, orig_w = img_raw.shape[:2]\n\n        # Threshold predicted mask\n        pred_mask = pred_masks[i, :, :, 0]\n        mask_uint8 = ((pred_mask > THRESH).astype(np.uint8) * 255)\n\n        contours, _ = cv2.findContours(mask_uint8, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n        if not contours:\n            continue\n\n        contours = [c for c in contours if cv2.contourArea(c) >= MIN_AREA_224]\n        if not contours:\n            continue\n\n        contours = sorted(contours, key=cv2.contourArea, reverse=True)[:MAX_GELS]\n\n        # Precompute channels once\n        blue, green, red = cv2.split(img_raw)\n        img_hsv = cv2.cvtColor(img_raw, cv2.COLOR_BGR2HSV)\n        hue, sat, val = cv2.split(img_hsv)\n        img_lab = cv2.cvtColor(img_raw, cv2.COLOR_BGR2LAB)\n        l_chan, a_chan, b_chan = cv2.split(img_lab)\n\n        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (ERODE_KERNEL, ERODE_KERNEL))\n\n        per_gel_features = []\n        per_gel_qc = []\n\n        for gel_idx, contour in enumerate(contours, start=1):\n            single_mask_224 = np.zeros_like(mask_uint8, dtype=np.uint8)\n            cv2.drawContours(single_mask_224, [contour], -1, 1, thickness=cv2.FILLED)\n\n            full_size_mask = cv2.resize(\n                single_mask_224,\n                (ori