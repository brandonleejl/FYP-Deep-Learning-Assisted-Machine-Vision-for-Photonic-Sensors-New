found absolutely nothing\n","        \n","    largest_contour = max(contours, key=cv2.contourArea)\n","    clean_mask_224 = np.zeros_like(mask_uint8)\n","    cv2.drawContours(clean_mask_224, [largest_contour], -1, 1, thickness=cv2.FILLED)\n","    \n","    # Upscale the clean mask back to the massive original photo size\n","    full_size_mask = cv2.resize(clean_mask_224, (orig_w, orig_h), interpolation=cv2.INTER_NEAREST)\n","    \n","    # --- CHEMISTRY EXTRACTION: RGB & HSV ---\n","    blue, green, red = cv2.split(img_raw)\n","    \n","    # Extract HSV (Note: OpenCV Hue goes from 0 to 179, not 360)\n","    img_hsv = cv2.cvtColor(img_raw, cv2.COLOR_BGR2HSV)\n","    hue, sat, val = cv2.split(img_hsv)\n","    \n","    # Isolate only the pixels inside our clean AI mask\n","    valid_green = green[full_size_mask == 1]\n","    valid_red = red[full_size_mask == 1]\n","    valid_hue = hue[full_size_mask == 1]\n","    \n","    if len(valid_red) == 0:\n","        return None\n","        \n","    # Calculate the medians (This deletes the UV glare!)\n","    median_g = np.median(valid_green)\n","    median_r = np.median(valid_red)\n","    median_h = np.median(valid_hue)\n","    \n","    if median_r == 0:\n","        return None\n","        \n","    ratio = median_g / median_r\n","    \n","    return {\n","        'Filename': filename,\n","        'Median_Green_FITC': median_g,\n","        'Median_Red_R6G': median_r,\n","        'Green_Red_Ratio': ratio,\n","        'Median_Hue_Angle': median_h  # <--- The Hue feature!\n","    }\n","\n","# --- 4. Run the Mass Pipeline ---\n","all_files = sorted(os.listdir(NEW_IMAGES_DIR))\n","image_names = [f for f in all_files if f.upper().endswith(('.PNG', '.JPG', '.JPEG'))]\n","\n","print(f\"Found {len(image_names)} raw images. Igniting extraction pipeline...\")\n","\n","results = []\n","for img_name in tqdm(image_names, desc=\"Processing Images\"):\n","    img_path = os.path.join(NEW_IMAGES_DIR, img_name)\n","    data = extract_chemistry(img_path, img_name)\n","    if data:\n","        results.append(data)\n","\n","# --- 5. Export ---\n","df = pd.DataFrame(results)\n","df.to_csv(OUTPUT_CSV, index=False)\n","print(f\"\\nExtracted chemical data saved to: {OUTPUT_CSV}\")"]},{"cell_type":"code","execution_count":7,"id":"4d1119b7","metadata":{"execution":{"iopub.execute_input":"2026-03-11T18:44:13.335834Z","iopub.status.busy":"2026-03-11T18:44:13.335433Z","iopub.status.idle":"2026-03-11T18:44:13.356391Z","shell.execute_reply":"2026-03-11T18:44:13.355294Z"},"papermill":{"duration":0.209789,"end_time":"2026-03-11T18:44:13.357905","exception":false,"start_time":"2026-03-11T18:44:13.148116","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["--- AI Extracted Chemical Ratios ---\n","       Filename  Median_Green_FITC  Median_Red_R6G  Green_Red_Ratio  \\\n","0  IMG_6215.PNG              169.0           199.0         0.849246   \n","1  IMG_6216.PNG              170.0           199.0         0.854271   \n","2  IMG_6217.PNG              171.0           200.0         0.855000   \n","3  IMG_6218.PNG              168.0           199.0         0.844221   \n","4  IMG_6219.PNG              168.0           198.0         0.848485   \n","5  IMG_6220.PNG              169.0           198.0         0.853535   \n","6  IMG_6222.PNG              167.0           205.0         0.814634   \n","7  IMG_6223.PNG              168.0           205.0         0.819512   \n","8  IMG_6224.PNG              169.0           204.0         0.828431   \n","9  IMG_6225.PNG              169.0           207.0         0.816425   \n","\n","   Median_Hue_Angle  \n","0              26.0  \n","1              26.0  \n","2              26.0  \n","3              26.0  \n","4              26.0  \n","5              26.0  \n","6              25.0  \n","7              25.0  \n","8              25.0  \n","9              25.0  \n"]}],"source":["#Cell 6\n","import pandas as pd\n","\n","# Load the AI-extracted dataset\n","df = 