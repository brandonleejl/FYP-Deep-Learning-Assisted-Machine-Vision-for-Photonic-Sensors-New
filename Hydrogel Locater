t\n\n# --- 1. Set Your Kaggle File Paths Here ---\n# Paste the paths from your Kaggle 'Input' folder here!\nMODEL_PATH = '/kaggle/working/unet_gel_finder_augmented.keras'\nXGB_PATH = '/kaggle/working/biosensor_xgboost_model.pkl'\nTEST_IMAGE = '/kaggle/input/datasets/brandonleejl/fyp-test-images/FYP Test Images/IMG_7729.PNG' \n\n# --- 2. Load Models ---\nprint(\"Loading AI Brain...\")\nunet_model = tf.keras.models.load_model(MODEL_PATH, compile=False)\nxgb_model = joblib.load(XGB_PATH)\n\n# --- 3. Read and Prepare Image ---\nimg_bgr = cv2.imread(TEST_IMAGE)\nif img_bgr is None:\n    raise ValueError(f\"Error: Could not find the image at {TEST_IMAGE}. Check the path!\")\n\norig_h, orig_w = img_bgr.shape[:2]\nimg_rgb = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)\nimg_resized = cv2.resize(img_rgb, (224, 224), interpolation=cv2.INTER_AREA)\n\n# --- 4. Generate the AI Mask (U-Net) ---\ninput_tensor = np.expand_dims(img_resized.astype(np.float32) / 255.0, axis=0)\npred = unet_model.predict(input_tensor, verbose=0)[0, :, :, 0]\nmask_224 = (pred > 0.5).astype(np.uint8)\n\nmask_u8 = (mask_224 * 255).astype(np.uint8)\ncontours, _ = cv2.findContours(mask_u8, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n\ncontours = [c for c in contours if cv2.contourArea(c) >= 80]\ncontours = sorted(contours, key=cv2.contourArea, reverse=True)[:4]\n\nfull_mask_display = np.zeros((orig_h, orig_w), dtype=np.uint8)\ncore_mask_display = np.zeros((orig_h, orig_w), dtype=np.uint8)\n\nb, g, r = cv2.split(img_bgr)\nhsv = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2HSV)\nh, s, v = cv2.split(hsv)\n\nprint(f\"\\n--- AI ANALYSIS COMPLETE ---\")\nprint(f\"Found {len(contours)} hydrogel(s)!\")\nprint(f\"----------------------------\")\n\n# --- 5. Extract Colors & Predict pH ---\nfor i, c in enumerate(contours):\n    single_224 = np.zeros_like(mask_224, dtype=np.uint8)\n    cv2.drawContours(single_224, [c], -1, 1, thickness=cv2.FILLED)\n    \n    full_mask = cv2.resize(single_224, (orig_w, orig_h), interpolation=cv2.INTER_NEAREST)\n    \n    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (9, 9))\n    core_mask = cv2.erode(full_mask, kernel, iterations=1)\n    \n    full_mask_display = cv2.bitwise_or(full_mask_display, full_mask)\n    core_mask_display = cv2.bitwise_or(core_mask_display, core_mask)\n    \n    core_pixels = int(np.sum(core_mask == 1))\n    reliability = \"High\" if core_pixels > 500 else \"Medium\" if core_pixels > 200 else \"Low (Too small/glare)\"\n    \n    valid_g = g[core_mask == 1]\n    valid_r = r[core_mask == 1]\n    valid_h = h[core_mask == 1]\n    \n    if valid_r.size > 0 and np.median(valid_r) > 0:\n        m_green = float(np.median(valid_g))\n        m_red = float(np.median(valid_r))\n        ratio = float(m_green / (m_red + 1e-6))\n        m_hue = float(np.median(valid_h))\n        \n        features = np.array([[ratio, m_green, m_red, m_hue]], dtype=np.float32)\n        ph_pred = float(xgb_model.predict(features)[0])\n        \n        print(f\"Gel {i+1}: pH {ph_pred:.2f} | Reliability: {reliability} ({core_pixels} core pixels)\")\n\n\n\n# --- 6. Plot the Results Visually ---\nplt.figure(figsize=(18, 6))\n\nplt.subplot(1, 3, 1)\nplt.title(\"1. Original Image\")\nplt.imshow(img_rgb)\nplt.axis('off')\n\nplt.subplot(1, 3, 2)\nplt.title(\"2. U-Net AI Mask\")\nplt.imshow(full_mask_display, cmap='gray')\nplt.axis('off')\n\nplt.subplot(1, 3, 3)\nplt.title(\"3. Eroded Core (Reading Zone)\")\nplt.imshow(core_mask_display, cmap='gray')\nplt.axis('off')\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nimport json\nimport time\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nfrom sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score, accuracy_score\n\n# ==========================================\n# 1. SETUP & DEFENSIVE DIRECTORY CREATION\n# ==========================================\nOUTPUT_DIR = \"final_evaluation_outputs\"\nos.makedirs(OUTPUT_DIR, exist_ok=True)\n\nprint(f\"🚀 Starting Biosensor Pipeline Audit...\")\nprint(f\"📁 Saving all outputs to: ./{OUTPUT_DIR}/\")\n\n# Dictionary to store all text/JSON results\naudit_results = {\n    \"timestamp\": time.strftime(\"%Y-%m-%d %H:%M:%S\"),\n    \"modules_run\": [],\n    \"metrics\": {}\n}\n\n# ==========================================\n# 2. THE AUDITOR (Scans your Kaggle Globals)\n# ==========================================\n# We pass globals() into this function so it can look for your variables\nnotebook_vars = globals()\n\ndef find_var(possible_names, expected_type=None):\n    \"\"\"Safely searches globals for common variable names.\"\"\"\n    for name in possible_names:\n        if name in notebook_vars:\n            val = notebook_vars[name]\n            if expected_type is None or isinstance(val, expected_type):\n                return val\n    return None\n\n# Attempt to auto-detect the pipeline components\n# Looking for true pH and predicted pH arrays\ny_true = find_var(['y_true', 'y_test', 'true_ph', 'test_labels'], (list, np.ndarray, pd.Series))\ny_pred = find_var(['y_pred', 'pred_ph', 'predictions', 'xgb_preds'], (list, np.ndarray, pd.Series))\n\n# Looking for extracted color features (Ratio, Green, Red, Hue)\nX_features = find_var(['X_test', 'features', 'color_features', 'xgb_input'], (np.ndarray, pd.DataFrame))\n\n# Looking for U-Net masks\nmask_true = find_var(['mask_true', 'y_mask_true', 'ground_truth_masks'], (list, np.ndarray))\nmask_pred = find_var(['mask_pred', 'y_mask_pred', 'predicted_masks', 'unet_preds'], (list, np.ndarray))\n\n# Looking for loaded models for inference testing\nmain_model = find_var(['xgb_model', 'model', 'clf', 'regressor'])\nunet_model = find_var(['unet_model', 'segmentation_model'])\nold_model = find_var(['old_xgb_model', 'baseline_model'])\n\nprint(\"\\n🔍 Auditor Findings:\")\nprint(f\" - pH Ground Truth (y_true): {'Found' if y_true is not None else 'Missing'}\")\nprint(f\" - pH Predictions (y_pred): {'Found' if y_pred is not None else 'Missing'}\")\nprint(f\" - Color Features (X_test): {'Found' if X_features is not None else 'Missing'}\")\nprint(f\" - U-Net Masks (True/Pred): {'Found' if mask_true is not None and mask_pred is not None else 'Missing'}\")\n\n# ==========================================\n# 3. METRIC COMPUTATION MODULES\n# ==========================================\n\n# --- A. Regression / pH Prediction Metrics ---\nif y_true is not None and y_pred is not None:\n    try:\n        y_t = np.array(y_true).flatten()\n        y_p = np.array(y_pred).flatten()\n        \n        if len(y_t) == len(y_p) and len(y_t) > 0:\n            print(\"\\n📊 Computing pH Regression Metrics...\")\n            mse = mean_squared_error(y_t, y_p)\n            rmse = np.sqrt(mse)\n            mae = mean_absolute_error(y_t, y_p)\n            r2 = r2_score(y_t, y_p)\n            \n            audit_results[\"metrics\"][\"regression\"] = {\n                \"MSE\": round(mse, 4), \"RMSE\": round(rmse, 4),\n                \"MAE\": round(mae, 4), \"R2_Score\": round(r2, 4)\n            }\n            audit_results[\"modules_run\"].append(\"Regression\")\n            \n            # Save to CSV\n            df_preds = pd.DataFrame({\"Actual_pH\": y_t, \"Predicted_pH\": y_p})\n            df_preds[\"Error\"] = abs(df_preds[\"Actual_pH\"] - df_preds[\"Predicted_pH\"])\n            df_preds.to_csv(f\"{OUTPUT_DIR}/ph_predictions_audit.csv\", index=False)\n            \n            # Plot: Actual vs Predicted\n            plt.figure(figsize=(8, 6))\n            sns.regplot(x=y_t, y=y_p, scatter_kws={'alpha':0.6}, line_kws={'color':'red'})\n            plt.plot([min(y_t), max(y_t)], [min(y_t), max(y_t)], '--', color='gray', label='Perfect Prediction')\n            plt.title(\"Actual vs Predicted pH\")\n            plt.xlabel(\"Actual pH\")\n            plt.ylabel(\"Predicted pH\")\n            plt.legend()\n            plt.grid(True, alpha=0.3)\n            plt.savefig(f\"{OUTPUT_DIR}/regression_scatter.png\", dpi=300, bbox_inches='tight')\n            plt.close()\n            \n            # Plot: Error Distribution\n            plt.figure(figsize=(8, 6))\n            sns.histplot(df_preds[\"Error\"], bins=15, kde=True, color='purple')\n            plt.title(\"Absolute Prediction Error Distribution\")\n            plt.xlabel(\"Absolute Error (pH units)\")\n            plt.savefig(f\"{OUTPUT_DIR}/error_distribution.png\", dpi=300, bbox_inches='tight')\n            plt.close()\n            \n    except Exception as e:\n        print(f\"⚠️ Skipping Regression Metrics due to error: {e}\")\n\n# --- B. Segmentation Metrics (IoU & Dice) ---\nif mask_true is not None and mask_pred is not None:\n    try:\n        print(\"🔲 Computing U-Net Segmentation Metrics...\")\n        m_t = np.array(mask_true) > 0.5  # Binarize\n        m_p = np.array(mask_pred) > 0.5\n        \n        intersection = np.logical_and(m_t, m_p).sum()\n        union = np.logical_or(m_t, m_p).sum()\n        iou = intersection / (union + 1e-6)\n        \n        dice = (2. * intersection) / (m_t.sum() + m_p.sum() + 1e-6)\n        \n        audit_results[\"metrics\"][\"segmentation\"] = {\n            \"Mean_IoU\": round(float(iou), 4),\n            \"Mean_Dice\": round(float(dice), 4)\n        }\n        audit_results[\"modules_run\"].append(\"Segmentation\")\n        \n    except Exception as e:\n        print(f\"⚠️ Skipping Segmentation Metrics due to error: {e}\")\n\n# --- C. Color Feature Analysis ---\nif X_features is not None and y_true is not None:\n    try:\n        print(\"🎨 Computing Color Feature Correlations...\")\n        # Assume standard structure if it's a numpy array without columns\n        if isinstance(X_features, np.ndarray):\n            cols = [\"Ratio\", \"Green\", \"Red\", \"Hue\"] if X_features.shape[1] == 4 else [f\"Feature_{i}\" for i in range(X_features.shape[1])]\n            df_feat = pd.DataFrame(X_features, columns=cols)\n        else:\n            df_feat = X_features.copy()\n            \n        df_feat[\"Target_pH\"] = np.array(y_true).flatten()\n        \n        # Save features to CSV\n        df_feat.to_csv(f\"{OUTPUT_DIR}/extracted_features.csv\", index=False)\n        \n        # Calculate Correlation\n        corr_matrix = df_feat.corr()\n        audit_results[\"metrics\"][\"feature_correlation_with_pH\"] = corr_matrix[\"Target_pH\"].drop(\"Target_pH\").to_dict()\n        audit_results[\"modules_run\"].append(\"Feature_Analysis\")\n        \n        # Plot Correlation Heatmap\n        plt.figure(figsize=(8, 6))\n        sns.heatmap(corr_matrix, annot=True, cmap=\"coolwarm\", fmt=\".2f\")\n        plt.title(\"Feature vs pH Correlation Heatmap\")\n        plt.savefig(f\"{OUTPUT_DIR}/feature_correlation_heatmap.png\", dpi=300, bbox_inches='tight')\n        plt.close()\n        \n    except Exception as e:\n        print(f\"⚠️ Skipping Feature Analysis due to error: {e}\")\n\n# --- D. Deployment / Inference Latency ---\nif main_model is not None and X_features is not None:\n    try:\n        print(\"⏱️ Computing Inference Latency (Deployment Readiness)...\")\n        sample_input = np.array(X_features)[0:1] # Take 1 sample\n        \n        # Warmup\n        _ = main_model.predict(sample_input)\n        \n        # Time 100 predictions\n        start_time = time.time()\n        for _ in range(100):\n            _ = main_model.predict(sample_input)\n        end_time = time.time()\n        \n        avg_latency_ms = ((end_time - start_time) / 100) * 1000\n        \n        audit_results[\"metrics\"][\"deployment\"] = {\n            \"avg_inference_time_ms\": round(avg_latency_ms, 3)\n        }\n        audit_results[\"modules_run\"].append(\"Inference_Latency\")\n    except Exception as e:\n        print(f\"⚠️ Skipping Inference Latency due to error: {e}\")\n\n# ==========================================\n# 4. COMPILE & SAVE FINAL REPORT\n# =============================