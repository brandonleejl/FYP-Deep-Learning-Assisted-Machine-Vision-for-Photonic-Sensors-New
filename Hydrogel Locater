p.ndarray, pd.Series))\n","y_pred = find_var(['y_pred', 'pred_ph', 'predictions', 'xgb_preds'], (list, np.ndarray, pd.Series))\n","\n","# Looking for extracted color features (Ratio, Green, Red, Hue)\n","X_features = find_var(['X_test', 'features', 'color_features', 'xgb_input'], (np.ndarray, pd.DataFrame))\n","\n","# Looking for U-Net masks\n","mask_true = find_var(['mask_true', 'y_mask_true', 'ground_truth_masks'], (list, np.ndarray))\n","mask_pred = find_var(['mask_pred', 'y_mask_pred', 'predicted_masks', 'unet_preds'], (list, np.ndarray))\n","\n","# Looking for loaded models for inference testing\n","main_model = find_var(['xgb_model', 'model', 'clf', 'regressor'])\n","unet_model = find_var(['unet_model', 'segmentation_model'])\n","old_model = find_var(['old_xgb_model', 'baseline_model'])\n","\n","print(\"\\n🔍 Auditor Findings:\")\n","print(f\" - pH Ground Truth (y_true): {'Found' if y_true is not None else 'Missing'}\")\n","print(f\" - pH Predictions (y_pred): {'Found' if y_pred is not None else 'Missing'}\")\n","print(f\" - Color Features (X_test): {'Found' if X_features is not None else 'Missing'}\")\n","print(f\" - U-Net Masks (True/Pred): {'Found' if mask_true is not None and mask_pred is not None else 'Missing'}\")\n","\n","# ==========================================\n","# 3. METRIC COMPUTATION MODULES\n","# ==========================================\n","\n","# --- A. Regression / pH Prediction Metrics ---\n","if y_true is not None and y_pred is not None:\n","    try:\n","        y_t = np.array(y_true).flatten()\n","        y_p = np.array(y_pred).flatten()\n","        \n","        if len(y_t) == len(y_p) and len(y_t) > 0:\n","            print(\"\\n📊 Computing pH Regression Metrics...\")\n","            mse = mean_squared_error(y_t, y_p)\n","            rmse = np.sqrt(mse)\n","            mae = mean_absolute_error(y_t, y_p)\n","            r2 = r2_score(y_t, y_p)\n","            \n","            audit_results[\"metrics\"][\"regression\"] = {\n","                \"MSE\": round(mse, 4), \"RMSE\": round(rmse, 4),\n","                \"MAE\": round(mae, 4), \"R2_Score\": round(r2, 4)\n","            }\n","            audit_results[\"modules_run\"].append(\"Regression\")\n","            \n","            # Save to CSV\n","            df_preds = pd.DataFrame({\"Actual_pH\": y_t, \"Predicted_pH\": y_p})\n","            df_preds[\"Error\"] = abs(df_preds[\"Actual_pH\"] - df_preds[\"Predicted_pH\"])\n","            df_preds.to_csv(f\"{OUTPUT_DIR}/ph_predictions_audit.csv\", index=False)\n","            \n","            # Plot: Actual vs Predicted\n","            plt.figure(figsize=(8, 6))\n","            sns.regplot(x=y_t, y=y_p, scatter_kws={'alpha':0.6}, line_kws={'color':'red'})\n","            plt.plot([min(y_t), max(y_t)], [min(y_t), max(y_t)], '--', color='gray', label='Perfect Prediction')\n","            plt.title(\"Actual vs Predicted pH\")\n","            plt.xlabel(\"Actual pH\")\n","            plt.ylabel(\"Predicted pH\")\n","            plt.legend()\n","            plt.grid(True, alpha=0.3)\n","            plt.savefig(f\"{OUTPUT_DIR}/regression_scatter.png\", dpi=300, bbox_inches='tight')\n","            plt.close()\n","            \n","            # Plot: Error Distribution\n","            plt.figure(figsize=(8, 6))\n","            sns.histplot(df_preds[\"Error\"], bins=15, kde=True, color='purple')\n","            plt.title(\"Absolute Prediction Error Distribution\")\n","            plt.xlabel(\"Absolute Error (pH units)\")\n","            plt.savefig(f\"{OUTPUT_DIR}/error_distribution.png\", dpi=300, bbox_inches='tight')\n","            plt.close()\n","            \n","    except Exception as e:\n","        print(f\"⚠️ Skipping Regression Metrics due to error: {e}\")\n","\n","# --- B. Segmentation Metrics (IoU & Dice) ---\n","if mask_true is not None and mask_pred is not None:\n","    try:\n","        print(\"🔲 Computing U-Net Segmentation Metrics...\")\n","        m_t = np.array(mask_true) > 0.5  # Binarize\