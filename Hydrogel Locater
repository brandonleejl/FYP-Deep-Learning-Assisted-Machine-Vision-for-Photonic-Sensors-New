\n","\"\"\"\n","if \"regression\" in audit_results[\"metrics\"]:\n","    r_mets = audit_results[\"metrics\"][\"regression\"]\n","    report_text += f\"R-Squared (R2): {r_mets['R2_Score']} (Closer to 1.0 is better)\\n\"\n","    report_text += f\"Mean Absolute Error (MAE): {r_mets['MAE']} pH units\\n\"\n","    report_text += f\"Root Mean Squared Error (RMSE): {r_mets['RMSE']} pH units\\n\"\n","else:\n","    report_text += \"No prediction arrays found to evaluate.\\n\"\n","\n","report_text += \"\\n--- 2. U-NET SEGMENTATION PERFORMANCE ---\\n\"\n","if \"segmentation\" in audit_results[\"metrics\"]:\n","    s_mets = audit_results[\"metrics\"][\"segmentation\"]\n","    report_text += f\"Intersection over Union (IoU): {s_mets['Mean_IoU']}\\n\"\n","    report_text += f\"Dice Coefficient: {s_mets['Mean_Dice']}\\n\"\n","else:\n","    report_text += \"No masks found to evaluate.\\n\"\n","\n","report_text += \"\\n--- 3. DEPLOYMENT READINESS ---\\n\"\n","if \"deployment\" in audit_results[\"metrics\"]:\n","    report_text += f\"Average Inference Latency: {audit_results['metrics']['deployment']['avg_inference_time_ms']} milliseconds per hydrogel.\\n\"\n","else:\n","    report_text += \"No model found to test latency.\\n\"\n","\n","with open(f\"{OUTPUT_DIR}/final_summary_report.txt\", \"w\") as f:\n","    f.write(report_text)\n","\n","print(f\"\\n✅ AUDIT COMPLETE! All files saved safely in the '{OUTPUT_DIR}' folder.\")\n","print(report_text)"]}],"metadata":{"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"databundleVersionId":15912399,"datasetId":9623840,"sourceId":15033821,"sourceType":"datasetVersion"},{"databundleVersionId":16010997,"datasetId":9631572,"sourceId":15123061,"sourceType":"datasetVersion"},{"databundleVersionId":16011368,"datasetId":9684207,"sourceId":15123389,"sourceType":"datasetVersion"},{"databundleVersionId":16010755,"datasetId":9631689,"sourceId":15122844,"sourceType":"datasetVersion"}],"dockerImageVersionId":31287,"isGpuEnabled":true,"isInternetEnabl