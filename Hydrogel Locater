indContours(mask_u8, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n","\n","contours = [c for c in contours if cv2.contourArea(c) >= 80]\n","contours = sorted(contours, key=cv2.contourArea, reverse=True)[:4]\n","\n","full_mask_display = np.zeros((orig_h, orig_w), dtype=np.uint8)\n","core_mask_display = np.zeros((orig_h, orig_w), dtype=np.uint8)\n","\n","b, g, r = cv2.split(img_bgr)\n","hsv = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2HSV)\n","h, s, v = cv2.split(hsv)\n","\n","print(f\"\\n--- AI ANALYSIS COMPLETE ---\")\n","print(f\"Found {len(contours)} hydrogel(s)!\")\n","print(f\"----------------------------\")\n","\n","# --- 5. Extract Colors & Predict pH ---\n","for i, c in enumerate(contours):\n","    single_224 = np.zeros_like(mask_224, dtype=np.uint8)\n","    cv2.drawContours(single_224, [c], -1, 1, thickness=cv2.FILLED)\n","    \n","    full_mask = cv2.resize(single_224, (orig_w, orig_h), interpolation=cv2.INTER_NEAREST)\n","    \n","    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (9, 9))\n","    core_mask = cv2.erode(full_mask, kernel, iterations=1)\n","    \n","    full_mask_display = cv2.bitwise_or(full_mask_display, full_mask)\n","    core_mask_display = cv2.bitwise_or(core_mask_display, core_mask)\n","    \n","    core_pixels = int(np.sum(core_mask == 1))\n","    reliability = \"High\" if core_pixels > 500 else \"Medium\" if core_pixels > 200 else \"Low (Too small/glare)\"\n","    \n","    valid_g = g[core_mask == 1]\n","    valid_r = r[core_mask == 1]\n","    valid_h = h[core_mask == 1]\n","    \n","    if valid_r.size > 0 and np.median(valid_r) > 0:\n","        m_green = float(np.median(valid_g))\n","        m_red = float(np.median(valid_r))\n","        ratio = float(m_green / (m_red + 1e-6))\n","        m_hue = float(np.median(valid_h))\n","        \n","        features = np.array([[ratio, m_green, m_red, m_hue]], dtype=np.float32)\n","        ph_pred = float(xgb_model.predict(features)[0])\n","        \n","        print(f\"Gel {i+1}: pH {ph_pred:.2