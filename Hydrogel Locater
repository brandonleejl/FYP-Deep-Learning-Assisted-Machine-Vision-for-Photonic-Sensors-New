input/datasets/brandonleejl/labels/labels.csv.csv'), \n              left_on='Filename', right_on='filename', how='inner').dropna(subset=['ph', 'Median_Green_FITC'])\n\nX = df[['Green_Red_Ratio', 'Median_Green_FITC', 'Median_Red_R6G', 'Median_Hue_Angle']].values\ny = df['ph'].values\n\n# --- 2. Define the Regressors and Hyperparameters ---\nmodels_config = {\n    \"Linear/Ridge Regression (LR)\": {\n        \"model\": Ridge(),\n        \"params\": {'model__alpha': [0.1, 1.0, 10.0]}\n    },\n    \"Polynomial Regression (PR)\": {\n        \"model\": Pipeline([('poly', PolynomialFeatures(degree=2)), ('ridge', Ridge())]),\n        \"params\": {'model__ridge__alpha': [0.1, 1.0, 10.0]}\n    },\n    \"Support Vector Regressor (SVM)\": {\n        \"model\": SVR(),\n        \"params\": {'model__C': [0.1, 1, 10], 'model__kernel': ['linear', 'rbf'], 'model__gamma': ['scale', 'auto']}\n    },\n    \"K-Nearest Neighbors (KNN)\": {\n        \"model\": KNeighborsRegressor(),\n        \"params\": {'model__n_neighbors': [3, 5, 7, 9], 'model__weights': ['uniform', 'distance']}\n    },\n    \"Decision Tree (DT)\": {\n        \"model\": DecisionTreeRegressor(random_state=42),\n        \"params\": {'model__max_depth': [None, 5, 10, 15], 'model__min_samples_split': [2, 5, 10]}\n    },\n    \"Random Forest (RF)\": {\n        \"model\": RandomForestRegressor(random_state=42),\n        \"params\": {'model__n_estimators': [50, 100, 200], 'model__max_depth': [None, 10, 20]}\n    },\n    \"Gradient Boosting (GBC)\": {\n        \"model\": GradientBoostingRegressor(random_state=42),\n        \"params\": {'model__n_estimators': [50, 100], 'model__learning_rate': [0.05, 0.1], 'model__max_depth': [3, 5]}\n    },\n    \"XGBoost (XGB)\": {\n        \"model\": XGBRegressor(random_state=42, objective='reg:squarederror'),\n        \"params\": {'model__n_estimators': [50, 100, 200], 'model__learning_rate': [0.05, 0.1], 'model__max_depth': [3, 5, 7]}\n    }\n}\n\n# --- 3. The 5-Fold Cross-Validation Setup